{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issueTracker": "${issue_tracker_url}"
  },
  "license": "MIT",
  "icon": "assets/peacefulaura/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.emrila.peacefulaura.PeacefulAura"
    ],
    "fabric-datagen": [
      "org.emrila.peacefulaura.PeacefulAuraDataGenerator"
    ]
  },
  "mixins": [
    "peacefulaura.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "java": ">=25",
    "minecraft": "${minecraft_version}"
  }
}
